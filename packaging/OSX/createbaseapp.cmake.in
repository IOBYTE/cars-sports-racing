#==============================================================================
#
#    Generated Script file for creating the the base app bundle
#    Apple only
#
#==============================================================================

# Create the base.app

message(STATUS "Creating @CSR_BASE_BUNDLE_NAME@ bundle...")

file(COPY "@CMAKE_INSTALL_PREFIX@/"
      DESTINATION "@CSR_BASE_BUNDLE_NAME@"
      PATTERN "@CSR_DATADIR@/tracks/*" EXCLUDE
      PATTERN "@CSR_DATADIR@/cars/models/*" EXCLUDE)


file(GLOB SC_CARS
   LIST_DIRECTORIES TRUE
   "@CMAKE_INSTALL_PREFIX@/@CSR_DATADIR@/cars/models/sc-*")

foreach(_CAR ${SC_CARS})
   #message(STATUS "_CAR = ${_CAR}")
   file(COPY "${_CAR}"
   DESTINATION "@CSR_BASE_BUNDLE_NAME@/@CSR_DATADIR@/cars/models")
endforeach()

file(GLOB SC_TRACKS
      LIST_DIRECTORIES TRUE
      "@CMAKE_INSTALL_PREFIX@/@CSR_DATADIR@/tracks/circuit/espie")

foreach(_TRACK ${SC_TRACKS})
   #message(STATUS "_TRACK = ${_TRACK}")
   file(COPY "${_TRACK}"
      DESTINATION "@CSR_BASE_BUNDLE_NAME@/@CSR_DATADIR@/tracks/circuit")
endforeach()
