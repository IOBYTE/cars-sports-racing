# SD include dirs macros.
MACRO(ADD_INTERFACE_INCLUDEDIR)

  IF(IN_SOURCETREE)
    SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/interfaces)
  ELSE(IN_SOURCETREE)
    SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
  ENDIF(IN_SOURCETREE)

  FIND_PATH(INTERFACE_INCLUDE_DIR raceman.h
            PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
  FIND_PATH(INTERFACE_INCLUDE_DIR raceman.h
            PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
  MARK_AS_ADVANCED(INTERFACE_INCLUDE_DIR)
  IF(INTERFACE_INCLUDE_DIR)
    INCLUDE_DIRECTORIES(${INTERFACE_INCLUDE_DIR})
  ELSE(INTERFACE_INCLUDE_DIR)
    MESSAGE(FATAL_ERROR "Cannot find interface header files")
  ENDIF(INTERFACE_INCLUDE_DIR)

ENDMACRO(ADD_INTERFACE_INCLUDEDIR)

MACRO(ADD_CSRLIB_INCLUDEDIR)

  SET(CSRLIB_OPTIONAL FALSE)

  FOREACH(CSRLIB_LIB ${ARGN})

    IF(${CSRLIB_LIB} STREQUAL "OPTIONAL")
      SET(CSRLIB_OPTIONAL TRUE)
    ENDIF(${CSRLIB_LIB} STREQUAL "OPTIONAL")

  ENDFOREACH(CSRLIB_LIB ${ARGN})

  FOREACH(CSRLIB_LIB ${ARGN})

    SET(CSRLIB_FOUND_LIB TRUE)
    SET(CSRLIB_EXTRA_INCLUDEDIR "")
    IF(CSRLIB_LIB STREQUAL "portability")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/libs/portability)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_PORTABILITY_INCLUDE_DIR portability.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_PORTABILITY_INCLUDE_DIR portability.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_PORTABILITY_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_PORTABILITY_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "tgf")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/libs/tgf)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_TGF_INCLUDE_DIR tgf.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_TGF_INCLUDE_DIR tgf.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_TGF_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_TGF_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "tgfclient")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/libs/tgfclient)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_TGFCLIENT_INCLUDE_DIR tgfclient.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_TGFCLIENT_INCLUDE_DIR tgfclient.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_TGFCLIENT_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_TGFCLIENT_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "tgfdata")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/libs/tgfdata)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_TGFDATA_INCLUDE_DIR tgfdata.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_TGFDATA_INCLUDE_DIR tgfdata.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_TGFDATA_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_TGFDATA_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "math")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/libs/math)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_MATH_INCLUDE_DIR linalg_t.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include PATH_SUFFIXES "" math tmath NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_MATH_INCLUDE_DIR linalg_t.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include PATH_SUFFIXES "" math tmath)
      MARK_AS_ADVANCED(CSRLIB_MATH_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_MATH_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "txml")
      # Temporary, as TXML will finally get replaced by Expat.
      IF(NOT OPTION_3RDPARTY_EXPAT)
        IF(IN_SOURCETREE)
          SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/libs/txml)
        ELSE(IN_SOURCETREE)
          SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
        ENDIF(IN_SOURCETREE)
        FIND_PATH(CSRLIB_TXML_INCLUDE_DIR xml.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
        FIND_PATH(CSRLIB_TXML_INCLUDE_DIR xml.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
        MARK_AS_ADVANCED(CSRLIB_TXML_INCLUDE_DIR)
        SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_TXML_INCLUDE_DIR)
      ELSE(NOT OPTION_3RDPARTY_EXPAT)
        SET(CSRLIB_FOUND_LIB FALSE)
      ENDIF(NOT OPTION_3RDPARTY_EXPAT)
    ELSEIF(CSRLIB_LIB STREQUAL "robottools")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/libs/robottools)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_ROBOTTOOLS_INCLUDE_DIR robottools.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_ROBOTTOOLS_INCLUDE_DIR robottools.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_ROBOTTOOLS_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_ROBOTTOOLS_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "learning")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/libs/learning)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_LEARNING_INCLUDE_DIR learn_debug.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include PATH_SUFFIXES "" learning NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_LEARNING_INCLUDE_DIR learn_debug.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include PATH_SUFFIXES "" learning)
      MARK_AS_ADVANCED(CSRLIB_LEARNING_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_LEARNING_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "networking")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/modules/networking)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_NETWORKING_INCLUDE_DIR network.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_NETWORKING_INCLUDE_DIR network.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_NETWORKING_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_NETWORKING_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "csnetworking")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/modules/csnetworking)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_CSNETWORKING_INCLUDE_DIR csnetwork.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_CSNETWORKING_INCLUDE_DIR csnetwork.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_CSNETWORKING_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_CSNETWORKING_INCLUDE_DIR)
	ELSEIF(CSRLIB_LIB STREQUAL "opengl1")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/modules/graphic/opengl1)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_OPENGL1_INCLUDE_DIR opengl1.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_OPENGL1_INCLUDE_DIR opengl1.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_OPENGL1_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_OPENGL1_INCLUDE_DIR)
	ELSEIF(CSRLIB_LIB STREQUAL "opengl3")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/modules/graphic/opengl3)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_OPENGL3_INCLUDE_DIR OpenGL3.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_OPENGL3_INCLUDE_DIR OpenGL3.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_OPENGL3_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_OPENGL3_INCLUDE_DIR)
    ELSEIF(CSRLIB_LIB STREQUAL "standardgame")
      IF(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${SOURCE_DIR}/src/modules/racing/standardgame)
      ELSE(IN_SOURCETREE)
        SET(INCLUDE_CANDIDATE ${CSR_INCLUDEDIR_ABS})
      ENDIF(IN_SOURCETREE)
      FIND_PATH(CSRLIB_STANDARDGAME_INCLUDE_DIR standardgame.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include NO_DEFAULT_PATH)
      FIND_PATH(CSRLIB_STANDARDGAME_INCLUDE_DIR standardgame.h PATHS ${INCLUDE_CANDIDATE} /usr/include /usr/local/include)
      MARK_AS_ADVANCED(CSRLIB_STANDARDGAME_INCLUDE_DIR)
      SET(CSRLIB_EXTRA_INCLUDEDIR CSRLIB_STANDARDGAME_INCLUDE_DIR)
    ELSE(CSRLIB_LIB STREQUAL "portability")
      SET(CSRSLIB_FOUND_LIB FALSE)
      IF(NOT CSRLIB_LIB STREQUAL "OPTIONAL")
        MESSAGE(WARNING ": ${CSRLIB_LIB} is not a Cars Sports Racing library")
      ENDIF(NOT CSRLIB_LIB STREQUAL "OPTIONAL")
    ENDIF(CSRLIB_LIB STREQUAL "portability")
    IF(CSRLIB_FOUND_LIB)
      IF(${CSRLIB_EXTRA_INCLUDEDIR})
        SET(CSRLIB_INCLUDE_DIRS ${CSRLIB_INCLUDE_DIRS} ${${CSRLIB_EXTRA_INCLUDEDIR}})
      ELSE(${CSRLIB_EXTRA_INCLUDEDIR})
        IF(NOT CSRLIB_OPTIONAL AND NOT CSRLIB_LIB STREQUAL "OPTIONAL")
          MESSAGE(FATAL_ERROR "Cannot find ${CSRLIB_LIB} library header files")
        ENDIF(NOT CSRLIB_OPTIONAL AND NOT CSRLIB_LIB STREQUAL "OPTIONAL")
      ENDIF(${CSRLIB_EXTRA_INCLUDEDIR})
    ENDIF(CSRLIB_FOUND_LIB)

  ENDFOREACH(CSRLIB_LIB ${CSRLIB_LIBS})

  INCLUDE_DIRECTORIES(${CSRLIB_INCLUDE_DIRS})

ENDMACRO(ADD_CSRLIB_INCLUDEDIR)

# SD libraries macro.
MACRO(ADD_CSRLIB_LIBRARY TARGET)

  #MESSAGE(STATUS "ADD_CSRLIB_LIBRARY : TARGET = ${TARGET}")
  #MESSAGE(STATUS "ADD_CSRLIB_LIBRARY : ARGN = ${ARGN}")

  SET(CSRLIB_OPTIONAL FALSE)
  SET(CSRLIB_STATIC FALSE)
  SET(CSRLIB_TARGET_SUFFIX "")

  FOREACH(CSRLIB_LIB ${ARGN})
    IF(${CSRLIB_LIB} STREQUAL "OPTIONAL")
      SET(CSRLIB_OPTIONAL TRUE)
    ENDIF(${CSRLIB_LIB} STREQUAL "OPTIONAL")
    IF(${CSRLIB_LIB} STREQUAL "STATIC")
      SET(CSRLIB_STATIC TRUE)
      SET(CSRLIB_TARGET_SUFFIX "_static")
    ENDIF(${CSRLIB_LIB} STREQUAL "STATIC")
  ENDFOREACH(CSRLIB_LIB ${ARGN})

  FOREACH(CSRLIB_LIB ${ARGN})

    SET(CSRLIB_IGNORE TRUE)
    IF(NOT UNIX)
      SET(CSRLIB_IGNORE FALSE)
    ELSEIF(NOT CSRLIB_LIB STREQUAL "opengl1" AND NOT CSRLIB_LIB STREQUAL "opengl3" AND NOT CSRLIB_LIB STREQUAL "track")
      SET(CSRLIB_IGNORE FALSE)
    ENDIF(NOT UNIX)

    IF(CSRLIB_LIB STREQUAL "OPTIONAL" OR CSRLIB_LIB STREQUAL "STATIC")
      SET(CSRLIB_IGNORE TRUE) #Ignore: not a real target
    ENDIF(CSRLIB_LIB STREQUAL "OPTIONAL" OR CSRLIB_LIB STREQUAL "STATIC")

    IF(CSRLIB_LIB STREQUAL "txml" AND OPTION_3RDPARTY_EXPAT)
      SET(CSRLIB_IGNORE TRUE) #Ignore: Use Expat
    ENDIF(CSRLIB_LIB STREQUAL "txml" AND OPTION_3RDPARTY_EXPAT)

    IF(CSRLIB_LIB STREQUAL "solid" AND OPTION_3RDPARTY_SOLID)
      SET(CSRLIB_IGNORE TRUE) #Ignore: Use 3rd party SOLID
    ENDIF(CSRLIB_LIB STREQUAL "solid" AND OPTION_3RDPARTY_SOLID)

    IF(NOT CSRLIB_IGNORE)

      SET(CSRLIB_LIBRARIES ${CSRLIB_LIBRARIES} ${CSRLIB_LIB}${CSRLIB_TARGET_SUFFIX})
      #MESSAGE(STATUS "ADD_CSRLIB_LIBRARY : CSRLIB_LIBRARIES = ${CSRLIB_LIBRARIES}")

    ENDIF(NOT CSRLIB_IGNORE)

  ENDFOREACH(CSRLIB_LIB ${CSRLIB_LIBS})

  #MESSAGE(STATUS "TARGET_LINK_LIBRARIES(${TARGET} ${CSRLIB_LIBRARIES})")
  TARGET_LINK_LIBRARIES(${TARGET} ${CSRLIB_LIBRARIES})

ENDMACRO(ADD_CSRLIB_LIBRARY TARGET)
