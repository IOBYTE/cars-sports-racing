<!-- 

	Host (network server) settings menu
	
-->

<!DOCTYPE params SYSTEM "../tgf/params.dtd">

<params name="hostsettingsmenu">
  	<section name="dynamic controls">
		<section name="carcatcombobox">
		  	<attstr name="type" val="combo box"/>
		  	<attnum name="x" val="300"/>
		  	<attnum name="y" val="330"/>
		  	<attnum name="width" val="160"/>
		  	<attnum name="arrows width" val="24"/>
		  	<attnum name="arrows height" val="24"/>	  
		  	<attnum name="max len" val="30"/>
		  	<attstr name="color" val="0xFFFFFF"/>
		  	<attstr name="focused color" val="0xFFCC00"/>
		  	<attstr name="pushed color" val="0xFFCC00"/>
		  	<attstr name="font" val ="medium"/>
		</section>

		<section name="carcollidecombobox">
		  	<attstr name="type" val="combo box"/>
		  	<attnum name="x" val="300"/>
		  	<attnum name="y" val="300"/>
		  	<attnum name="width" val="160"/>
		  	<attnum name="arrows width" val="24"/>
		  	<attnum name="arrows height" val="24"/>	  
		  	<attnum name="max len" val="10"/>
		  	<attstr name="color" val="0xFFFFFF"/>
		  	<attstr name="focused color" val="0xFFCC00"/>
		  	<attstr name="pushed color" val="0xFFCC00"/>
		  	<attstr name="font" val ="medium"/>
		</section>

		<section name="hosthumanplayercombobox">
		 	<attstr name="type" val="combo box"/>
		  	<attnum name="x" val="300"/>
		  	<attnum name="y" val="270"/>
		  	<attnum name="width" val="160"/>
		  	<attnum name="arrows width" val="24"/>
		  	<attnum name="arrows height" val="24"/>	  
		  	<attnum name="max len" val="30"/>
		  	<attstr name="color" val="0xFFFFFF"/>
		  	<attstr name="focused color" val="0xFFCC00"/>
		  	<attstr name="pushed color" val="0xFFCC00"/>
		  	<attstr name="font" val ="medium"/>
		</section>

		<section name="cancel">
		  	<attstr name="type" val="text button"/>
		  	<attstr name="text" val="Cancel"/>
		  	<attstr name="tip" val="Cancel Host Settings"/>
		  	<attnum name="x" val="160"/>
		  	<attnum name="y" val="40"/>
		  	<attnum name="width" val="80"/>
		  	<attstr name="h align" val="center"/>
		  	<attstr name="font" val ="medium"/>
		  	<attstr name="color" val="0xFFFFFF"/>
		  	<attstr name="focused color" val="0xFFFFFF"/>
		  	<attstr name="pushed color" val="0xFF0000"/>
		  	<attstr name="show box" val="no"/>                  
		</section>
		
		<section name="accept">
		  	<attstr name="type" val="text button"/>
		  	<attstr name="text" val="Accept"/>
		  	<attstr name="tip" val="Accept Host Settings"/>
		 	<attnum name="x" val="460"/>
		  	<attnum name="y" val="40"/>
		  	<attnum name="width" val="80"/>
		  	<attstr name="h align" val="center"/>
		  	<attstr name="font" val ="medium"/>
		  	<attstr name="color" val="0xFFFFFF"/>
		  	<attstr name="focused color" val="0xFFFFFF"/>
		  	<attstr name="pushed color" val="0xFF0000"/>
		  	<attstr name="show box" val="no"/>                  
		</section>
	</section>
  
  	<section name="static controls">
		<section name="1">
		  	<attstr name="type" val="background image"/>
		  	<attstr name="image" val="data/img/splash-networkhostsettings.jpg"/>
		</section>

		<section name="2">
		  	<attstr name="type" val="label"/>
		  	<attstr name="text" val="Car Class"/>
		  	<attstr name="font" val="medium"/>
		  	<attnum name="x" val="80"/>
		  	<attnum name="y" val="333"/>
		  	<attstr name="h align" val="right"/>
			<attnum name="width" val="200"/>
		  	<attstr name="color" val="0xFFFFFF"/>
		</section>

		<section name="3">
		  	<attstr name="type" val="label"/>
		  	<attstr name="text" val="Car Collisions"/>
		  	<attstr name="font" val="medium"/>
		  	<attnum name="x" val="80"/>
		  	<attnum name="y" val="303"/>
		  	<attstr name="h align" val="right"/>
			<attnum name="width" val="200"/>
		  	<attstr name="color" val="0xFFFFFF"/>
		</section>

		<section name="4">
		  	<attstr name="type" val="label"/>
		  	<attstr name="text" val="Host Human Player"/>
		  	<attstr name="font" val="medium"/>
		  	<attnum name="x" val="80"/>
		  	<attnum name="y" val="273"/>
		  	<attstr name="h align" val="right"/>
			<attnum name="width" val="200"/>
		  	<attstr name="color" val="0xFFFFFF"/>
		</section>
	</section>
</params>
