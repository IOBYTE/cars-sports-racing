<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">
	
<params name="Vortex GT" type="template">
<!--	The Vortex GT is an old-school French wedge from the 1990s, with
		a slew of mechanical upgrades to keep this car relevant. It is the
		lightest car in the category, but is desperately lacking in power.
-->
	<section name="Features">
