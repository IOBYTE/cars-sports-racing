<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">
<!--   The slightly overweight Lolita EXR57 is one hell of a speed demon.    -->
<!--   With a powerful turbo'd 2.0L straight four, the EXR57 P2 leaves even  -->
<!--   some P1 cars in the dust on a straight. Unfortunately, downforce...   -->
<!--   or more rather, the lack of it, seems to be a problem.                -->
<params name="Lolita EXR" type="template">
	<section name="Features">
		<!-- Mandatory Features -->
		<attstr name="shifting aero coordinate" in="yes" val="yes"/>
		<attstr name="fixed low speed grip" in="yes" val="yes"/>
		<attstr name="tire compounds" in="yes" val="yes"/>
		<!-- Optional Features -->
		<attstr name="enable abs" in="yes,no" val="yes"/>
		<attstr name="enable tcl" in="yes,no" val="yes"/>
		<attstr name="enable esp" in="yes,no" val="yes"/>
	</section>

