<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="Boxer 96 LS-RSR" type="template">
<!--   The Boxer 96 LS-RSR is a cute little German sports race car. It is an  -->
<!--   extremely rear-heavy car, due to (obviously) the rear-engine layout.   -->
<!--   Use this to your advantage by getting on the throttle early in slow    -->
<!--   corners, but be careful not to throw it in on entry or you'll spin.    -->
	<section name="Features">
		<!-- Mandatory Features -->
		<attstr name="shifting aero coordinate" in="yes" val="yes"/>
		<attstr name="fixed low speed grip" in="yes" val="yes"/>
		<attstr name="tire compounds" in="yes" val="yes"/>
		<!-- Optional Features -->
		<attstr name="enable abs" in="yes,no" val="yes"/>
		<attstr name="enable tcl" in="yes,no" val="yes"/>
		<attstr name="enable esp" in="no" val="no"/>
	</section>
	
	<section name="Bonnet">
		<!-- Position of the driver -->
		<attnum name="xpos" val="1.05" unit="m"/>
		<attnum name="ypos" val="0.0" unit="m"/>
		<attnum name="zpos" val="1.05" unit="m"/>
	</section>

	<section name="Driver">
		<!-- Position of the driver -->
		<attnum name="xpos" val="-0.12" unit="m"/>
		<attnum name="ypos" val="0.33" unit="m"/>
		<attnum name="zpos" val="0.85" unit="m"/>
	</section>


	<section name="Sound">
		<attstr name="engine sample" val="996rsr.wav"/>
		<attnum name="rpm scale" val="0.72"/>
	</section>


