<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<!--   The Bavaria G3 GTR is a well-rounded car with no real weaknesses.      -->
<!--   Although the subject of much controversy in the American Endurance     -->
<!--   Championship with its debut in 2001, it is well-known that Bavaria's   -->
<!--   sports coupe is more than a match for anything else of similar age.    -->

<params name="Bavaria G3 GTR" type="template">
	<section name="Features">
		<!-- Mandatory Features -->
		<attstr name="shifting aero coordinate" in="yes" val="yes"/>
		<attstr name="fixed low speed grip" in="yes" val="yes"/>
		<attstr name="tire compounds" in="yes" val="yes"/>
		<!-- Optional Features -->
		<attstr name="enable abs" in="yes,no" val="yes"/>
		<attstr name="enable tcl" in="yes,no" val="yes"/>
		<attstr name="enable esp" in="no" val="no"/>
	</section>
	
	<section name="Bonnet">
		<attnum name="xpos" unit="m" val="0.80"/>
		<attnum name="ypos" unit="m" val="0.0"/>
		<attnum name="zpos" unit="m" val="1.1"/>
	</section>

	<section name="Driver">
		<attnum name="xpos" unit="m" val="-0.13"/>
		<attnum name="ypos" unit="m" val="0.40"/>
		<attnum name="zpos" unit="m" val="0.95"/>
	</section>

	<section name="Sound">
	 <attstr name="engine sample" val="m3gtr2.wav"/>
		<attnum name="rpm scale" val="1.05"/>
	</section>

	<section name="Graphic Objects">
		<attstr name="env" val="ls2-bavaria-g3gtr.acc"/>
		<attstr name="wheel texture" val="tex-wheel.rgb"/>
		<attstr name="shadow texture" val="shadow.rgb"/>
		<attstr name="tachometer texture" val="rpm8500.png"/>
		<attnum name="tachometer min value" unit="rpm" val="0"/>
