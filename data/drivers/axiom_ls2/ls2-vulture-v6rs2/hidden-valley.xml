<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="ls2-vulture-v6rs2">
  	<section name="Front Wing">
    	<attnum name="angle" unit="deg" min="6" max="10" val="10"/>
  	</section>

  	<section name="Rear Wing">
    	<attnum name="angle" min="4" max="22" unit="deg" val="15"/>
  	</section>

	<section name="Gearbox">
		<section name="gears">
			<section name="r">
				<attnum name="ratio" min="-3" max="0" val="-2.0"/>
			</section>

			<section name="1">
				<attnum name="ratio" min="0" max="9" val="2.95"/>
			</section>

			<section name="2">
				<attnum name="ratio" min="0" max="5" val="2.43"/>
			</section>

			<section name="3">
				<attnum name="ratio" min="0" max="5" val="1.95"/>
			</section>

			<section name="4">
				<attnum name="ratio" min="0" max="5" val="1.46"/>
			</section>

			<section name="5">
				<attnum name="ratio" min="0" max="5" val="1.05"/>
			</section>

			<section name="6">
				<attnum name="ratio" min="0" max="5" val="0.80"/>
			</section>
		</section>
	</section>

  	<section name="private">
		<!-- Others -->
		<attnum name="test line" min="0" max="2" val="0"/> <!-- test line: 1 left, 2 right -->
		<attnum name="message on" min="0" max="1" val="0"/>
		<attnum name="data log on" min="0" max="1" val="0"/>

		<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="25.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.03"/>
		<attnum name="brake mu factor" val="0.86"/>
		<attnum name="LR mu scale" val="0.82"/>
		<attnum name="mu scale" val="0.88"/>
		<attnum name="brakepressrace" val="27000"/>
		<attnum name="brakepressnorm" val="23000"/>
		<attnum name="bump speed factor" val="1000.0"/>
		<attnum name="fuel per meter" val="0.0010"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.00001"/>
		<!--attnum name="max fuel" val="63"/-->

		<attnum name="pitdamage" val="5000"/>
		<attnum name="pitentrymargin" val="100.0"/>
		<attnum name="pitentryspeed" val="50.0"/>
		<attnum name="pitexitspeed" val="50.0"/>
		<attnum name="pittest" val="0"/>

		<attnum name="targetfactor" val="0.32"/>
		<attnum name="targetwalldist" val="0.0"/>
		<attnum name="lookahead" val="15.0"/>
		<!-- Race line ClothoidPath -->
		<attnum name="maxleft" val="10.0"/>
		<attnum name="maxright" val="10.0"/>
		<attnum name="clothoidfactor" val="1.013"/>
		<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>

		<!-- Mu Factor -->
		<attnum name="1 from" val="0"/>
		<attnum name="1 mufactor" val="0.92"/>

		<attnum name="2 from" val="2000"/>
		<attnum name="2 mufactor" val="0.85"/>

		<attnum name="3 from" val="10800"/>
		<attnum name="3 mufactor" val="0.83"/>

		<attnum name="4 from" val="16900"/>
		<attnum name="4 mufactor" val="0.91"/>

		<!-- Margins -->
		<attnum name="1 from margins" val="0"/>
		<attnum name="1 left" val="1.2"/>
		<attnum name="1 right" val="1.2"/>

		<attnum name="2 from margins" val="2000"/>
		<attnum name="2 left" val="0.9"/>
		<attnum name="2 right" val="1.9"/>

		<attnum name="3 from margins" val="10800"/>
		<attnum name="3 left" val="2.1"/>
		<attnum name="3 right" val="1.2"/>

		<attnum name="4 from margins" val="16900"/>
		<attnum name="4 left" val="1.2"/>
		<attnum name="4 right" val="1.2"/>
  	</section>
</params>
