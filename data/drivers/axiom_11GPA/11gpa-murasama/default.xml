<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="11gpa-murasama">
	<section name="Brake System">
		<attnum name="front-rear brake repartition" min="0.2" max="0.8" val="0.59"/>
		<attnum name="max pressure" unit="kPa" min="5000" max="65000" val="45000"/>
	</section>

	<section name="Front Right Wheel">
		<attnum name="toe" unit="deg" min="-5" max="5" val="+0.10"/>
		<attnum name="camber" min="-5" max="5" unit="deg" val="-0.85"/>
		<attnum name="pressure" unit="PSI" min="21" max="48" val="21.0"/>
	</section>

	<section name="Front Left Wheel">
		<attnum name="toe" unit="deg" min="-5" max="5" val="-0.10"/>
		<attnum name="camber" min="-5" max="5" unit="deg" val="-0.85"/>
		<attnum name="pressure" unit="PSI" min="21" max="48" val="33.0"/>
	</section>

	<section name="Rear Right Wheel">
		<attnum name="toe" unit="deg" min="-5" max="5" val="+0.10"/>
		<attnum name="camber" min="-5" max="5" unit="deg" val="-0.85"/>
		<attnum name="pressure" unit="PSI" min="19" max="36" val="19.0"/>
	</section>

	<section name="Rear Left Wheel">
		<attnum name="toe" unit="deg" min="-5" max="5" val="-0.10"/>
		<attnum name="camber" min="-5" max="5" unit="deg" val="-0.85"/>
		<attnum name="pressure" unit="PSI" min="19" max="36" val="22.0"/>
	</section>

  	<section name="private">
		<!-- Others -->
		<attnum name="test line" min="0" max="2" val="0"/> <!-- test line: 1 left, 2 right -->
		<attnum name="message on" min="0" max="1" val="0"/>
		<attnum name="data log on" min="0" max="1" val="0"/>

		<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="15.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.08"/>
		<attnum name="brake mu factor" val="0.93"/>
		<attnum name="LR mu scale" val="0.90"/>
		<attnum name="mu scale" val="0.78"/>
		<attnum name="mu scale soft" val="0.80"/>
		<attnum name="mu scale medium" val="0.80"/>
		<attnum name="mu scale hard" val="1.05"/>
		<attnum name="mu scale wet" val="0.80"/>
		<attnum name="mu scale extreme wet" val="0.80"/>
		<attnum name="brakepressrace" val="25000"/>
		<attnum name="brakepressnorm" val="28000"/>
		<attnum name="bump speed factor" val="1000.0"/>
		<attnum name="fuel per meter" val="0.0010"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.00001"/>
		<attnum name="max fuel" val=""/>

		<attnum name="pitdamage" val="5000"/>
		<attnum name="pitentrymargin" val="100.0"/>
		<attnum name="pitentryspeed" val="50.0"/>
		<attnum name="pitexitspeed" val="50.0"/>
		<attnum name="pittest" val="0"/>

		<attnum name="targetfactor" val="0.32"/>
		<attnum name="targetwalldist" val="0.2"/>
		<attnum name="lookahead" val="14.0"/>
		<!-- Race line ClothoidPath -->
		<attnum name="maxleft" val="10.0"/>
		<attnum name="maxright" val="10.0"/>
		<attnum name="clothoidfactor" val="1.013"/>
		<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>
  	</section>

	<section name="strategy">
		<attnum name="fuel 5 laps" val="13.0"/>
		<attnum name="fuel 10 laps" val="22.0"/>
		<attnum name="fuel 80 km" val="56.0"/>
		<attnum name="fuel 160 km" val="54.0"/>
		<attnum name="fuel 320 km" val="62.0"/>
		<attnum name="fuel others" val="62.0"/>
		<attnum name="tires 5 laps 15" val="1"/>
		<attnum name="tires 5 laps 20" val="1"/>
		<attnum name="tires 5 laps 25" val="1"/>
		<attnum name="tires 15 laps 15" val="1"/>
		<attnum name="tires 15 laps 20" val="2"/>
		<attnum name="tires 15 laps 25" val="2"/>
		<attnum name="tires 80KM 15" val="1"/>
		<attnum name="tires 80KM 20" val="2"/>
		<attnum name="tires 80KM 25" val="3"/>
		<attnum name="tires 160KM 15" val="1"/>
		<attnum name="tires 160KM 20" val="2"/>
		<attnum name="tires 160KM 25" val="3"/>
		<attnum name="tires 320KM 15" val="2"/>
		<attnum name="tires 320KM 20" val="3"/>
		<attnum name="tires 320KM 25" val="3"/>
		<attnum name="tires other 15" val="3"/>
		<attnum name="tires other 20" val="3"/>
		<attnum name="tires other 25" val="3"/>
