<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="11gpa-murasama">
  	<section name="Front Wing">
    	<attnum name="angle" unit="deg" min="0" max="12" val="12.0"/>
  	</section>

  	<section name="Rear Wing">
    	<attnum name="angle" unit="deg" min="0" max="17" val="3.0"/>
  	</section>

	<section name="Gearbox">
    	<section name="gears">
      		<section name="r">
        		<attnum name="ratio" min="-3" max="0" val="-2"/>
      		</section>

      		<section name="1">
        		<attnum name="ratio" min="0" max="5" val="2.6"/>
      		</section>

      		<section name="2">
        		<attnum name="ratio" min="0" max="5" val="1.82"/>
      		</section>

      		<section name="3">
        		<attnum name="ratio" min="0" max="5" val="1.426"/>
      		</section>

      		<section name="4">
        		<attnum name="ratio" min="0" max="5" val="1.150"/>
      		</section>

      		<section name="5">
        		<attnum name="ratio" min="0" max="5" val="0.908"/>
      		</section>

      		<section name="6">
        		<attnum name="ratio" min="0" max="5" val="0.710"/>
      		</section>
    	</section>
  	</section>

	<section name="Brake System">
		<attnum name="front-rear brake repartition" min="0.2" max="0.8" val="0.59"/>
		<attnum name="max pressure" unit="kPa" min="5000" max="65000" val="45000"/>
	</section>

	<section name="Front Right Wheel">
		<attnum name="toe" unit="deg" min="-5" max="5" val="+0.10"/>
		<attnum name="camber" min="-5" max="5" unit="deg" val="-0.85"/>
		<attnum name="pressure" unit="PSI" min="21" max="48" val="21.0"/>
	</section>

	<section name="Front Left Wheel">
		<attnum name="toe" unit="deg" min="-5" max="5" val="-0.10"/>
		<attnum name="camber" min="-5" max="5" unit="deg" val="-0.85"/>
	</section>

  	<section name="private">
    	<!-- Others -->
    	<attnum name="test line" min="0" max="2" val="0"/> <!-- test line: 1 left, 2 right -->
    	<attnum name="message on" min="0" max="1" val="0"/>
    	<attnum name="data log on" min="0" max="1" val="0"/>

    	<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="25.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.03"/>
    	<attnum name="brake mu factor" val="0.74"/>
    	<attnum name="brake mu factor qualif" val="0.79"/>
    	<attnum name="brake mu factor cold" val="0.77"/>
    	<attnum name="LR mu scale" val="0.80"/>
    	<attnum name="mu scale" val="1.27"/>
    	<attnum name="mu scale qualif" val="1.39"/>
    	<attnum name="mu scale cold" val="1.45"/>
    	<attnum name="brakepressrace" val="50000"/>
    	<attnum name="brakepressnorm" val="50000"/>
    	<attnum name="bump speed factor" val="1000.0"/>
    	<attnum name="fuel per meter" val="0.0012"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.00001"/>
		<attnum name="max fuel" val=""/>

    	<attnum name="pitdamage" val="5000"/>
    	<attnum name="pitentrymargin" val="90.0"/>
    	<attnum name="pitentryspeed" val="20.0"/>
