    	<attnum name="targetfactor" val="0.32"/>
    	<attnum name="targetwalldist" val="0.5"/>
		<attnum name="lookahead" val="14.0"/>
    	<!-- Race line ClothoidPath -->
    	<attnum name="maxleft" val="10.0"/>
    	<attnum name="maxright" val="9.0"/>
   	 	<attnum name="clothoidfactor" val="1.013"/>
    	<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>

		<!-- Mu Factor -->
		<attnum name="1 from" val="0"/>
		<attnum name="1 mufactor" val="1.50"/>
		<attnum name="1 brake mufactor" val="0.70"/>

		<attnum name="2 from" val="400"/>
		<attnum name="2 mufactor" val="1.0"/>
		<attnum name="2 brake mufactor" val="0.60"/>

		<attnum name="3 from" val="700"/>
		<attnum name="3 mufactor" val="1.40"/>
		<attnum name="3 brake mufactor" val="0.7"/>

		<attnum name="4 from" val="1400"/>
		<attnum name="4 mufactor" val="1.0"/>
		<attnum name="4 brake mufactor" val="0.70"/>

		<attnum name="5 from" val="2000"/>
		<attnum name="5 mufactor" val="1.50"/>
		<attnum name="5 brake mufactor" val="0.70"/>

		<!-- Margins -->
		<attnum name="1 from margins" val="0"/>
		<attnum name="1 left" val="1.2"/>
		<attnum name="1 right" val="1.1"/>

		<attnum name="2 from margins" val="400"/>
		<attnum name="2 left" val="0.7"/>
		<attnum name="2 right" val="1.1"/>

		<attnum name="3 from margins" val="650"/>
		<attnum name="3 left" val="1.2"/>
		<attnum name="3 right" val="1.1"/>

		<attnum name="4 from margins" val="1400"/>
		<attnum name="4 left" val="0.6"/>
		<attnum name="4 right" val="1.1"/>

		<attnum name="5 from margins" val="1900"/>
		<attnum name="5 left" val="1.2"/>
		<attnum name="5 right" val="1.1"/>
  	</section>

	<section name="strategy">
		<attnum name="fuel 5 laps" val="13.0"/>
		<attnum name="fuel 10 laps" val="32.0"/>
		<attnum name="fuel 80 km" val="56.0"/>
		<attnum name="fuel 160 km" val="54.0"/>
		<attnum name="fuel 320 km" val="62.0"/>
		<attnum name="fuel others" val="62.0"/>
