<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="11gpa-murasama">
  	<section name="Front Wing">
    	<attnum name="angle" unit="deg" min="0" max="12" val="9.0"/>
  	</section>

  	<section name="Rear Wing">
    	<attnum name="angle" unit="deg" min="0" max="17" val="3.0"/>
  	</section>

	<section name="Gearbox">
    	<section name="gears">
      		<section name="r">
        		<attnum name="ratio" min="-3" max="0" val="-2"/>
      		</section>

      		<section name="1">
        		<attnum name="ratio" min="0" max="5" val="2.6"/>
      		</section>

      		<section name="2">
        		<attnum name="ratio" min="0" max="5" val="1.82"/>
      		</section>

      		<section name="3">
        		<attnum name="ratio" min="0" max="5" val="1.426"/>
      		</section>

      		<section name="4">
        		<attnum name="ratio" min="0" max="5" val="1.150"/>
      		</section>

      		<section name="5">
        		<attnum name="ratio" min="0" max="5" val="0.908"/>
      		</section>

      		<section name="6">
        		<attnum name="ratio" min="0" max="5" val="0.720"/>
      		</section>
    	</section>
  	</section>

	<section name="Brake System">
		<attnum name="front-rear brake repartition" min="0.2" max="0.8" val="0.48"/>
		<attnum name="max pressure" unit="kPa" min="5000" max="65000" val="60000"/>
	</section>

  	<section name="private">
    	<!-- Others -->
    	<attnum name="test line" min="0" max="2" val="0"/> <!-- test line: 1 left, 2 right -->
    	<attnum name="message on" min="0" max="1" val="0"/>
    	<attnum name="data log on" min="0" max="1" val="0"/>

    	<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="25.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.03"/>
    	<attnum name="brake mu factor" val="0.95"/>
    	<attnum name="brake mu factor qualif" val="0.99"/>
    	<attnum name="brake mu factor cold" val="0.97"/>
    	<attnum name="LR mu scale" val="0.80"/>
    	<attnum name="mu scale" val="0.90"/>
    	<attnum name="mu scale qualif" val="0.95"/>
    	<attnum name="mu scale cold" val="0.90"/>
    	<attnum name="mu scale soft" val="0.80"/>
    	<attnum name="mu scale medium" val="0.80"/>
    	<attnum name="mu scale hard" val="1.05"/>
    	<attnum name="mu scale wet" val="0.80"/>
    	<attnum name="mu scale extreme wet" val="0.80"/>
    	<attnum name="brakepressrace" val="30000"/>
    	<attnum name="brakepressnorm" val="31000"/>
    	<attnum name="bump speed factor" val="1000.0"/>
    	<attnum name="fuel per meter" val="0.0012"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.00001"/>
		<attnum name="max fuel" val=""/>

    	<attnum name="pitdamage" val="1800"/>
    	<attnum name="pitentrymargin" val="100.0"/>
    	<attnum name="pitentryspeed" val="40.0"/>
    	<attnum name="pitexitspeed" val="50.0"/>
		<attnum name="pitgripfactor" val="0.65"/>
    	<attnum name="pittest" val="0"/>

    	<attnum name="targetfactor" val="0.32"/>
    	<attnum name="targetwalldist" val="0.4"/>
		<attnum name="lookahead" val="14.0"/>
    	<!-- Race line ClothoidPath -->
    	<attnum name="maxleft" val="10.0"/>
    	<attnum name="maxright" val="9.0"/>
    	<attnum name="clothoidfactor" val="1.013"/>
    	<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>

		<!-- Mu Factor -->
		<attnum name="1 from" val="0"/>
		<attnum name="1 mufactor" val="1.10"/>
		<attnum name="1 brake mufactor" val="1.20"/>

		<attnum name="2 from" val="500"/>
		<attnum name="2 mufactor" val="0.96"/>
		<attnum name="2 brake mufactor" val="1.20"/>

		<attnum name="3 from" val="800"/>
		<attnum name="3 mufactor" val="1.0"/>
		<attnum name="3 brake mufactor" val="1.20"/>

		<attnum name="4 from" val="1500"/>
		<attnum name="4 mufactor" val="0.93"/>
		<attnum name="4 brake mufactor" val="1.20"/>

		<attnum name="5 from" val="1800"/>
		<attnum name="5 mufactor" val="1.10"/>
		<attnum name="5 brake mufactor" val="1.2"/>
		
		<!-- Margins -->
		<attnum name="1 from margins" val="0"/>
		<attnum name="1 left" val="1.2"/>
		<attnum name="1 right" val="1.1"/>

		<attnum name="2 from margins" val="500"/>
		<attnum name="2 left" val="0.5"/>
		<attnum name="2 right" val="1.4"/>

		<attnum name="3 from margins" val="800"/>
		<attnum name="3 left" val="1.2"/>
		<attnum name="3 right" val="1.1"/>

		<attnum name="4 from margins" val="1500"/>
		<attnum name="4 left" val="0.5"/>
		<attnum name="4 right" val="1.4"/>

		<attnum name="5 from margins" val="1800"/>
		<attnum name="5 left" val="1.2"/>
		<attnum name="5 right" val="1.1"/>
  	</section>

	<section name="strategy">
		<attnum name="fuel 5 laps" val="9.0"/>
		<attnum name="fuel 10 laps" val="32.0"/>
		<attnum name="fuel 80 km" val="56.0"/>
		<attnum name="fuel 160 km" val="54.0"/>
		<attnum name="fuel 320 km" val="62.0"/>
		<attnum name="fuel others" val="62.0"/>
		<attnum name="tires 5 laps 15" val="1"/>
		<attnum name="tires 5 laps 20" val="2"/>
		<attnum name="tires 5 laps 25" val="2"/>
		<attnum name="tires 15 laps 15" val="1"/>
		<attnum name="tires 15 laps 20" val="2"/>
		<attnum name="tires 15 laps 25" val="2"/>
		<attnum name="tires 80KM 15" val="1"/>
		<attnum name="tires 80KM 20" val="2"/>
		<attnum name="tires 80KM 25" val="3"/>
		<attnum name="tires 160KM 15" val="1"/>
		<attnum name="tires 160KM 20" val="2"/>
		<attnum name="tires 160KM 25" val="2"/>
		<attnum name="tires 320KM 15" val="1"/>
		<attnum name="tires 320KM 20" val="2"/>
		<attnum name="tires 320KM 25" val="2"/>
		<attnum name="tires other 15" val="3"/>
		<attnum name="tires other 20" val="3"/>
		<attnum name="tires other 25" val="3"/>
		<attnum name="num arrets" val="2"/>
	</section>
</params>
