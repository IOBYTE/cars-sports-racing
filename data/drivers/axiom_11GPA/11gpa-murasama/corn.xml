<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="11gpa-murasama">
  	<section name="Front Wing">
    	<attnum name="angle" unit="deg" min="0" max="12" val="12.0"/>
  	</section>

  	<section name="Rear Wing">
    	<attnum name="angle" unit="deg" min="0" max="17" val="6.0"/>
  	</section>

	<section name="Gearbox">
    	<section name="gears">
      		<section name="r">
        		<attnum name="ratio" min="-3" max="0" val="-2"/>
      		</section>

      		<section name="1">
        		<attnum name="ratio" min="0" max="5" val="2.6"/>
      		</section>

      		<section name="2">
        		<attnum name="ratio" min="0" max="5" val="1.82"/>
      		</section>

      		<section name="3">
        		<attnum name="ratio" min="0" max="5" val="1.426"/>
      		</section>

      		<section name="4">
        		<attnum name="ratio" min="0" max="5" val="1.150"/>
      		</section>

      		<section name="5">
        		<attnum name="ratio" min="0" max="5" val="0.958"/>
      		</section>

      		<section name="6">
        		<attnum name="ratio" min="0" max="5" val="0.840"/>
      		</section>
    	</section>
  	</section>

	<section name="Brake System">
		<attnum name="front-rear brake repartition" min="0.2" max="0.8" val="0.51"/>
		<attnum name="max pressure" unit="kPa" min="5000" max="65000" val="60000"/>
	</section>

  	<section name="private">
   		<!-- Others -->
    	<attnum name="test line" min="0" max="2" val="0"/> <!-- test line: 1 left, 2 right -->
    	<attnum name="message on" min="0" max="1" val="0"/>
    	<attnum name="data log on" min="0" max="1" val="0"/>

    	<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="25.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.03"/>
    	<attnum name="brake mu factor" val="0.82"/>
    	<attnum name="brake mu factor qualif" val="0.90"/>
    	<attnum name="brake mu factor cold" val="0.90"/>
    	<attnum name="LR mu scale" val="0.78"/>
    	<attnum name="mu scale" val="0.95"/>
    	<attnum name="mu scale qualif" val="0.99"/>
    	<attnum name="mu scale cold" val="0.99"/>
    	<attnum name="mu scale soft" val="0.79"/>
    	<attnum name="mu scale medium" val="0.80"/>
    	<attnum name="mu scale hard" val="0.80"/>
    	<attnum name="mu scale wet" val="0.80"/>
    	<attnum name="mu scale extreme wet" val="0.80"/>
    	<attnum name="brakepressrace" val="30000"/>
    	<attnum name="brakepressnorm" val="30000"/>
    	<attnum name="bump speed factor" val="1000.0"/>
    	<attnum name="fuel per meter" val="0.0013"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.00001"/>
		<attnum name="max fuel" val=""/>

    	<attnum name="pitdamage" val="1800"/>
    	<attnum name="pitentrymargin" val="100.0"/>
    	<attnum name="pitentryspeed" val="50.0"/>
    	<attnum name="pitexitspeed" val="50.0"/>
    	<attnum name="pittest" val="0"/>

    	<attnum name="targetfactor" val="0.32"/>
    	<attnum name="targetwalldist" val="0.2"/>
		<attnum name="lookahead" val="14.0"/>
    	<!-- Race line ClothoidPath -->
    	<attnum name="maxleft" val="10.0"/>
    	<attnum name="maxright" val="9.0"/>
    	<attnum name="clothoidfactor" val="1.013"/>
    	<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>

		<!-- Mu Factor -->
		<attnum name="1 from" val="0"/>
		<attnum name="1 mufactor" val="1.20"/>
		<attnum name="1 brake mufactor" val="1.0"/>

		<attnum name="2 from" val="250"/>
		<attnum name="2 mufactor" val="0.90"/>
		<attnum name="2 brake mufactor" val="0.95"/>

		<attnum name="3 from" val="420"/>
		<attnum name="3 mufactor" val="1.20"/>
		<attnum name="3 brake mufactor" val="1.0"/>

		<attnum name="4 from" val="890"/>
		<attnum name="4 mufactor" val="0.90"/>
		<attnum name="4 brake mufactor" val="0.95"/>

		<attnum name="5 from" val="1350"/>
		<attnum name="5 mufactor" val="1.20"/>
		<attnum name="5 brake mufactor" val="1.0"/>

		<!-- Margins -->
		<attnum name="1 from margins" val="0"/>
		<attnum name="1 left" val="1.2"/>
		<attnum name="1 right" val="1.2"/>

		<attnum name="2 from margins" val="420"/>
		<attnum name="2 left" val="1.9"/>
		<attnum name="2 right" val="01.1"/>

		<attnum name="3 from margins" val="890"/>
		<attnum name="3 left" val="1.2"/>
		<attnum name="3 right" val="1.1"/>

		<attnum name="4 from margins" val="1300"/>
		<attnum name="4 left" val="1.2"/>
		<attnum name="4 right" val="1.1"/>
	</section>

</params>
