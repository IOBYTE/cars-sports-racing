<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="36gp-milano-tipop3">
	<section name="Gearbox">
    	<section name="gears">
      		<section name="1">
				<attnum name="ratio" min="0" max="10" val="2.10"/>
			</section>
      		<section name="2">
				<attnum name="ratio" min="0" max="10" val="1.70"/>
      		</section>
      		<section name="3">
				<attnum name="ratio" min="0" max="10" val="1.50"/>
      		</section>
      		<section name="4">
				<attnum name="ratio" min="0" max="10" val="1.30"/>
      		</section>
    	</section>
  	</section>

	<section name="Brake System">
		<attnum name="front-rear brake repartition" min="0.1" max="0.9" val="0.49"/>
		<attnum name="max pressure" unit="kPa" min="100" max="10000" val="9500"/>
	</section>

	<section name="private">
		<!-- Others -->
		<attnum name="test line" min="0" max="2" val="0"/> <!-- test line: 1 left, 2 right -->
		<attnum name="message on" min="0" max="1" val="0"/>
		<attnum name="data log on" min="0" max="1" val="0"/>

		<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="25.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.03"/>
		<attnum name="brake mu factor" val="0.87"/>
		<attnum name="LR mu scale" val="0.82"/>
		<attnum name="mu scale" val="0.92"/>
		<attnum name="brakepressrace" val="31000"/>
		<attnum name="brakepressnorm" val="31000"/>
		<attnum name="bump speed factor" val="1000.0"/>
		<attnum name="fuel per meter" val="0.0007"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.0001"/>
		<attnum name="max fuel" val="63"/>

		<attnum name="pitdamage" val="5000"/>
		<attnum name="pitentrymargin" val="180.0"/>
		<attnum name="pitentryspeed" val="50.0"/>
		<attnum name="pitexitspeed" val="50.0"/>

		<attnum name="targetfactor" val="0.32"/>
		<attnum name="targetwalldist" val="0.5"/>
		<attnum name="lookahead" val="14.0"/>
		<!-- Race line ClothoidPath -->
		<attnum name="maxleft" val="10.0"/>
		<attnum name="maxright" val="10.0"/>
		<attnum name="clothoidfactor" val="1.013"/>
		<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>


		<!-- Mu Factor -->
		<attnum name="1 from" val="0"/>
		<attnum name="1 mufactor" val="1.0"/>
		<attnum name="1 brakemufactor" val="1.0"/>

		<attnum name="2 from" val="700"/>
		<attnum name="2 mufactor" val="0.90"/>
		<attnum name="2 brakemufactor" val="0.82"/>

		<attnum name="3 from" val="900"/>
		<attnum name="3 mufactor" val="1.0"/>
		<attnum name="3 brakemufactor" val="1.0"/>

		<attnum name="4 from" val="1500"/>
		<attnum name="4 mufactor" val="0.90"/>
		<attnum name="4 brakemufactor" val="0.82"/>

		<attnum name="5 from" val="1800"/>
		<attnum name="5 mufactor" val="1.0"/>
		<attnum name="5 brakemufactor" val="1.0"/>

		<attnum name="6 from" val="1900"/>
		<attnum name="6 mufactor" val="0.90"/>
		<attnum name="6 brakemufactor" val="0.82"/>

		<attnum name="7 from" val="2000"/>
		<attnum name="7 mufactor" val="1.0"/>
		<attnum name="7 brakemufactor" val="1.0"/>

		<attnum name="8 from" val="4000"/>
		<attnum name="8 mufactor" val="0.90"/>
		<attnum name="8 brakemufactor" val="0.82"/>

		<attnum name="9 from" val="4300"/>
		<attnum name="9 mufactor" val="1.0"/>
		<attnum name="9 brakemufactor" val="1.0"/>

		<attnum name="10 from" val="11000"/>
		<attnum name="10 mufactor" val="0.90"/>
		<attnum name="10 brakemufactor" val="0.82"/>

		<attnum name="11 from" val="13300"/>
		<attnum name="11 mufactor" val="1.0"/>
		<attnum name="11 brakemufactor" val="1.0"/>
	</section>
</params>
