<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="Skill" type="template">
   	<section name="skill">
	  	<!-- This skill level is added to the global skill level set in        -->
	  	<!-- raceman/config/extra/skill.xml to provide a unique value for      -->
	  	<!-- each driver.  The values should be between 0 and 1, with 0 being  -->
	  	<!-- the highest skill level.                                          -->
	  	<attnum name="level" min="0.0" max="1.0" val="0.21"/>
	  	<attnum name="level qualif" min="0.0" max="5.0" val="4.0"/>
	  	<attnum name="aggression" min="-0.04" max="0.04" val="0.04"/>
	  	<attnum name="skill random" min="0" max="210" val="210"/>
	  	<attnum name="skill random qualif" min="0" max="4000" val="980"/>
   	</section>

	<section name="Options">
		<attnum name="options mass" val="1"/>
		<attnum name="options gear" val="0"/>
		<attnum name="options engine" val="3"/>
		<attnum name="options springs" val="0"/>
		<attnum name="options anti-roll bars" val="0"/>
		<attnum name="options wings" val="0"/>
		<attnum name="options tires" val="1"/>
 	</section>
</params>
