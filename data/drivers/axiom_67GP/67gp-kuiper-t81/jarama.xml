<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="67gp-kuiper-t81">
	<section name="Brake System">
		<attnum name="front-rear brake repartition" min="0.3" max="0.7" val="0.42"/>
		<attnum name="max pressure" unit="kPa" min="100" max="20000" val="18500"/>
	</section>

	<section name="private">
		<!-- Others -->
		<attnum name="test line" min="0" max="2" val="0"/> <!-- test line: 1 left, 2 right -->
		<attnum name="message on" min="0" max="1" val="0"/>
		<attnum name="data log on" min="0" max="1" val="0"/>

		<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="25.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.03"/>
		<attnum name="brake mu factor" val="0.80"/>
		<attnum name="brake mu factor qualif" val="0.85"/>
		<attnum name="brake mu factor cold" val="0.85"/>
		<attnum name="LR mu scale" val="0.78"/>
		<attnum name="mu scale" val="0.83"/>
		<attnum name="mu scale qualif" val="0.87"/>
		<attnum name="mu scale cold" val="0.86"/>
		<attnum name="brakepressrace" val="28000"/>
		<attnum name="brakepressnorm" val="28000"/>
		<attnum name="bump speed factor" val="1000.0"/>
		<attnum name="fuel per meter" val="0.0007"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.0001"/>
		<attnum name="max fuel" val="63"/>

		<attnum name="pitdamage" val="5000"/>
		<attnum name="pitentrymargin" val="100.0"/>
		<attnum name="pitentryspeed" val="50.0"/>
		<attnum name="pitexitspeed" val="50.0"/>

		<attnum name="targetfactor" val="0.32"/>
		<attnum name="targetwalldist" val="0.5"/>
		<attnum name="lookahead" val="14.0"/>
		<!-- Race line ClothoidPath -->
		<attnum name="maxleft" val="10.0"/>
		<attnum name="maxright" val="9.0"/>
		<attnum name="clothoidfactor" val="1.013"/>
		<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>

		<!-- Mu Factor -->
		<attnum name="1 from" val="0"/>
		<attnum name="1 mufactor" val="0.94"/>
		<attnum name="1 brakemufactor" val="0.97"/>

		<attnum name="2 from" val="150"/>
		<attnum name="2 mufactor" val="0.70"/>
		<attnum name="2 brakemufactor" val="0.70"/>

		<attnum name="3 from" val="410"/>
		<attnum name="3 mufactor" val="0.95"/>
		<attnum name="3 brakemufactor" val="0.97"/>

		<attnum name="4 from" val="2530"/>
		<attnum name="4 mufactor" val="0.55"/>
		<attnum name="4 brakemufactor" val="0.50"/>

		<attnum name="5 from" val="2630"/>
		<attnum name="5 mufactor" val="0.94"/>
		<attnum name="5 brakemufactor" val="0.97"/>

		<!-- Margins -->
		<attnum name="1 from margins" val="0"/>
		<attnum name="1 left" val="2.2"/>
		<attnum name="1 right" val="0.5"/>

		<attnum name="2 from margins" val="150"/>
		<attnum name="2 left" val="1.9"/>
		<attnum name="2 right" val="0.5"/>

		<attnum name="3 from margins" val="410"/>
		<attnum name="3 left" val="1.2"/>
		<attnum name="3 right" val="1.2"/>
	</section>
</params>
