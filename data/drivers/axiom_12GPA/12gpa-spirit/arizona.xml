<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="mpa12-deckard">
	<section name="Front Wing">
		<attnum name="angle" unit="deg" val="5"/>
	</section>

	<section name="Rear Wing">
		<attnum name="angle" unit="deg" val="8"/>
	</section>

	<section name="Gearbox">
    	<section name="gears">
      		<section name="r">
        		<attnum name="ratio" min="-3" max="0" val="-2"/>
      		</section>

      		<section name="1">
        		<attnum name="ratio" min="0" max="5" val="2.600"/>
      		</section>

      		<section name="2">
        		<attnum name="ratio" min="0" max="5" val="1.820"/>
      		</section>

      		<section name="3">
        		<attnum name="ratio" min="0" max="5" val="1.430"/>
      		</section>

      		<section name="4">
        		<attnum name="ratio" min="0" max="5" val="1.200"/>
      		</section>

      		<section name="5">
        		<attnum name="ratio" min="0" max="5" val="0.990"/>
      		</section>

      		<section name="6">
        		<attnum name="ratio" min="0" max="5" val="0.870"/>
      		</section>
    	</section>
  	</section>

	<section name="Brake System">
		<attnum name="front-rear brake repartition" min="0.15" max="0.85" val="0.52"/>
		<attnum name="max pressure" unit="kPa" min="5350" max="8000" val="8000"/>
	</section>

	<section name="Tires Set">
		<attnum name="compound set" min="1" max="5" val="1" />
	</section>

  	<section name="private">
		<!-- Others -->
		<attnum name="test line" min="0" max="2" val="1"/> <!-- test line: 1 left, 2 right -->
		<attnum name="message on" min="0" max="1" val="1"/>
		<attnum name="data log on" min="0" max="1" val="1"/>

		<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="25.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.03"/>
		<attnum name="brake mu factor" val="0.90"/>
		<attnum name="brake mu factor qualif" val="1.01"/>
		<attnum name="brake mu factor cold" val="0.90"/>
    	<attnum name="LR mu scale" val="0.85"/>
		<attnum name="mu scale" val="1.20"/>
		<attnum name="mu scale qualif" val="1.30"/>
		<attnum name="mu scale cold" val="1.30"/>
		<attnum name="brakepressrace" val="30000"/>
		<attnum name="brakepressnorm" val="31000"/>
		<attnum name="bump speed factor" val="1000.0"/>
		<attnum name="fuel per meter" val="0.0020"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.0001"/>
		<attnum name="max fuel" val="63"/>

		<attnum name="pitdamage" val="3000"/>
		<attnum name="pitentrymargin" val="160.0"/>
		<attnum name="pitentryspeed" val="50.0"/>
		<attnum name="pitexitspeed" val="50.0"/>
		<attnum name="pittest" val="0"/>

		<attnum name="targetfactor" val="0.32"/>
		<attnum name="targetwalldist" val="0.5"/>
		<attnum name="lookahead" val="14.0"/>
		<!-- Race line ClothoidPath -->
		<attnum name="maxleft" val="9.0"/>
		<attnum name="maxright" val="9.0"/>
		<attnum name="clothoidfactor" val="1.013"/>
		<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>

		<!-- Mu Factor -->
		<attnum name="1 from" val="0"/>
		<attnum name="1 mufactor" val="1.10"/>
		<attnum name="1 brake mufactor" val="0.75"/>

		<attnum name="2 from" val="250"/>
		<attnum name="2 mufactor" val="0.89"/>
		<attnum name="1 brake mufactor" val="0.80"/>

		<attnum name="3 from" val="310"/>
		<attnum name="3 mufactor" val="0.90"/>
		<attnum name="1 brake mufactor" val="0.78"/>

		<attnum name="4 from" val="500"/>
		<attnum name="4 mufactor" val="1.00"/>
		<attnum name="1 brake mufactor" val="0.75"/>

		<attnum name="5 from" val="600"/>
		<attnum name="5 mufactor" val="1.0"/>
		<attnum name="1 brake mufactor" val="0.75"/>

		<attnum name="6 from" val="1000"/>
		<attnum name="6 mufactor" val="0.93"/>
		<attnum name="1 brake mufactor" val="0.75"/>

		<attnum name="7 from" val="1400"/>
		<attnum name="7 mufactor" val="1.00"/>
		<attnum name="1 brake mufactor" val="0.75"/>

		<!-- Margins -->
		<attnum name="1 from margins" val="0"/>
		<attnum name="1 left" val="1.1"/>
		<attnum name="1 right" val="1.0"/>

		<attnum name="2 from margins" val="200"/>
		<attnum name="2 left" val="0.6"/>
		<attnum name="2 right" val="0.9"/>

		<attnum name="3 from margins" val="310"/>
		<attnum name="3 left" val="0.7"/>
		<attnum name="3 right" val="1.0"/>

		<attnum name="4 from margins" val="500"/>
		<attnum name="4 left" val="1.1"/>
		<attnum name="4 right" val="1.0"/>

		<attnum name="5 from margins" val="680"/>
		<attnum name="5 left" val="0.5"/>
		<attnum name="5 right" val="1.0"/>

		<attnum name="6 from margins" val="800"/>
		<attnum name="6 left" val="1.1"/>
		<attnum name="6 right" val="1.0"/>

		<attnum name="7 from margins" val="1000"/>
		<attnum name="7 left" val="0.5"/>
		<attnum name="7 right" val="1.0"/>

		<attnum name="8 from margins" val="1400"/>
		<attnum name="8 left" val="1.1"/>
		<attnum name="8 right" val="1.0"/>
  	</section>
</params>
