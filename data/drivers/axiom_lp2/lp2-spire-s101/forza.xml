<!DOCTYPE params SYSTEM "../../../../src/libs/tgf/params.dtd">

<params name="lp2-spire-s101">
	<section name="Front Wing">
		<attnum name="angle" unit="deg" min="7" max="19" val="12"/>
  	</section>

  	<section name="Rear Wing">
		<attnum name="angle" unit="deg" min="8" max="24" val="8"/>
  	</section>

  	<section name="Gearbox">
    	<section name="gears">
      		<section name="1">
				<attnum name="ratio" min="0" max="5" val="2.66"/>
      		</section>

      		<section name="2">
				<attnum name="ratio" min="0" max="5" val="1.78"/>
      		</section>

      		<section name="3">
				<attnum name="ratio" min="0" max="5" val="1.3"/>
      		</section>

      		<section name="4">
				<attnum name="ratio" min="0" max="5" val="1.00"/>
      		</section>

      		<section name="5">
				<attnum name="ratio" min="0" max="5" val="0.80"/>
      		</section>

      		<section name="6">
				<attnum name="ratio" min="0" max="5" val="0.70"/>
      		</section>
    	</section>
  	</section>

  	<section name="Brake System">
		<attnum name="front-rear brake repartition" min="0.3" max="0.7" val="0.41"/>
		<attnum name="max pressure" unit="kPa" min="100" max="150000" val="45000"/>
  	</section>

  	<section name="private">
    	<!-- Others -->
    	<attnum name="test line" min="0" max="2" val="0"/> <!-- test line: 1 left, 2 right -->
    	<attnum name="message on" min="0" max="1" val="0"/>
    	<attnum name="data log on" min="0" max="1" val="0"/>

    	<attnum name="ABS slip" val="14.0"/>
		<attnum name="TCL side slip" val="25.0"/>
		<attnum name="TCL side slip qualy" val="40.0"/>
		<attnum name="TCL side slip factor" val="0.03"/>
    	<attnum name="brake mu factor" val="0.97"/>
    	<attnum name="brake mu factor qualif" val="1.02"/>
    	<attnum name="brake mu factor cold" val="1.02"/>
    	<attnum name="LR mu scale" val="0.95"/>
    	<attnum name="mu scale" val="0.85"/>
    	<attnum name="mu scale qualif" val="0.95"/>
    	<attnum name="mu scale cold" val="0.95"/>
    	<attnum name="brakepressrace" val="30000"/>
    	<attnum name="brakepressnorm" val="31000"/>
    	<attnum name="bump speed factor" val="1000.0"/>
    	<attnum name="fuel per meter" val="0.0010"/>
		<attnum name="fuel weight factor" val="1.0"/>
		<attnum name="tire wear per meter" val="0.00001"/>
		<!--attnum name="max fuel" val="63"/-->

    	<attnum name="pitdamage" val="5000"/>
    	<attnum name="pitentrymargin" val="100.0"/>
    	<attnum name="pitentryspeed" val="50.0"/>
    	<attnum name="pitexitspeed" val="50.0"/>
    	<attnum name="pittest" val="0"/>

    	<attnum name="targetfactor" val="0.32"/>
    	<attnum name="targetwalldist" val="0.0"/>
		<attnum name="lookahead" val="14.0"/>
    	<!-- Race line ClothoidPath -->
    	<attnum name="maxleft" val="10.0"/>
    	<attnum name="maxright" val="10.0"/>
    	<attnum name="clothoidfactor" val="1.013"/>
    	<attnum name="seglen" val="4.0"/>
		<attnum name="vmaxk" val="0.00183"/>

<!-- Mu Factor -->
		<attnum name="1 from" val="0"/>
		<attnum name="1 mufactor" val="1.04"/>
		<attnum name="1 brakemufactor" val="1.04"/>

		<attnum name="2 from" val="1150"/>
		<attnum name="2 mufactor" val="0.65"/>
		<attnum name="2 brakemufactor" val="0.85"/>

		<attnum name="3 from" val="1300"/>
		<attnum name="3 mufactor" val="1.0"/>
		<attnum name="3 brakemufactor" val="1.0"/>

		<attnum name="4 from" val="4800"/>
		<attnum name="4 mufactor" val="0.82"/>
		<attnum name="4 brakemufactor" val="0.95"/>

		<attnum name="5 from" val="4900"/>
		<attnum name="5 mufactor" val="1.02"/>
		<attnum name="5 brakemufactor" val="1.04"/>
  	</section>
</params>
